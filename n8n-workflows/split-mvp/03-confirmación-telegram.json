{
  "name": "Kronos 03 - Confirmación Telegram",
  "nodes": [
    {
      "parameters": {
        "content": "## 2. Confirmación por Telegram (botones + callback)\nCallback del botón Confirmar/Rechazar -> UPDATE idempotente en Postgres -> respuesta al callback + aviso en el chat.",
        "height": 720,
        "width": 1750,
        "color": 5
      },
      "id": "914b900d-d98e-4b11-8a54-fa33f73488f1",
      "name": "Nota: 2. Confirmación Telegram",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -2680,
        480
      ]
    },
    {
      "parameters": {
        "updates": [
          "callback_query"
        ],
        "additionalFields": {}
      },
      "id": "9705a5a4-b00e-4d19-be1c-5d4f8cc77bea",
      "name": "Trigger Callback Telegram",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [
        -2600,
        800
      ],
      "webhookId": "kronos-telegram-callback-trigger",
      "notesInFlow": true,
      "credentials": {
        "telegramApi": {
          "id": "W4XHaBNANAtKf4Ih",
          "name": "Telegram account"
        }
      },
      "notes": "Recibe el callback_query cuando el usuario presiona Confirmar/Rechazar en la notificación. n8n registra el webhook automáticamente con la credencial del bot."
    },
    {
      "parameters": {
        "jsCode": "// Kronos Bot — Nodo Function: parsear callback_query de los botones\n// Fase A (solo botones, sin EA/MT4 todavía)\nconst callbackQuery = $input.first().json.callback_query;\nconst [action, signalIdRaw] = (callbackQuery.data || '').split(':');\nreturn [{\n  json: {\n    action, // 'confirm' o 'reject'\n    signalId: parseInt(signalIdRaw, 10),\n    callbackQueryId: callbackQuery.id,\n  },\n}];"
      },
      "id": "63d58f09-1098-456b-b3ca-fb7b520e5d7f",
      "name": "Parsear callback",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -2350,
        800
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 1
          },
          "conditions": [
            {
              "id": "cond-confirm-reject",
              "leftValue": "={{ $json.action }}",
              "rightValue": "confirm",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "d97957e1-2d85-4bf7-a25c-bf97c2e348e0",
      "name": "¿Confirmar o rechazar?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        -2100,
        800
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH updated AS (\n  UPDATE signals SET status = 'CONFIRMED', updated_at = NOW()\n  WHERE id = $1 AND status = 'PENDING_CONFIRMATION'\n  RETURNING id\n)\nSELECT\n  (SELECT COUNT(*) FROM updated) AS updated_count,\n  (SELECT status FROM signals WHERE id = $1) AS current_status;",
        "options": {
          "queryReplacement": "={{ [$('Parsear callback').item.json.signalId] }}"
        }
      },
      "id": "486d0a2e-5dd1-48ef-9791-43c9017ac2f6",
      "name": "Actualizar status: CONFIRMED",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        -1850,
        660
      ],
      "credentials": {
        "postgres": {
          "id": "7BHAPu1rIT8bxv9u",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH updated AS (\n  UPDATE signals SET status = 'REJECTED_BY_USER', updated_at = NOW()\n  WHERE id = $1 AND status = 'PENDING_CONFIRMATION'\n  RETURNING id\n)\nSELECT\n  (SELECT COUNT(*) FROM updated) AS updated_count,\n  (SELECT status FROM signals WHERE id = $1) AS current_status;",
        "options": {
          "queryReplacement": "={{ [$('Parsear callback').item.json.signalId] }}"
        }
      },
      "id": "71b6a6a1-bb0d-45f3-8df5-9bbb1cc52e12",
      "name": "Actualizar status: REJECTED_BY_USER",
